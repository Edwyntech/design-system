{
  "name": "@edwyn-tech/design-system",
  "version": "1.0.0",
  "description": "Design System for Edwyn Tech, built with WebComponents (Lit) and pure TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "web-types": "./web-types.json",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "src",
    "web-types.json",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./typography.css": "./src/tokens/typography.css",
    "./style.css": "./dist/index.css",
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "manifest": "cem analyze",
    "build": "tsc --noEmit && cem analyze && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css,mdx}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,mdx}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "@web-types/lit": "^2.0.0-3",
    "custom-element-jet-brains-integration": "^1.8.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
